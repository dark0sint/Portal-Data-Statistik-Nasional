# Contoh konfigurasi Nginx sebagai reverse proxy untuk Portal Data Statistik Nasional
# Simpan sebagai /etc/nginx/sites-available/portal-statistik lalu buat symlink ke sites-enabled

server {
    listen 80;
    server_name data.namadomainanda.go.id;   # ganti dengan domain Anda

    location / {
        proxy_pass         http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header    Host $host;
        proxy_set_header    X-Real-IP $remote_addr;
        proxy_set_header    X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header    X-Forwarded-Proto $scheme;
    }

    # Opsional: aktifkan gzip untuk performa
    gzip on;
    gzip_types text/css application/javascript application/json text/plain;
}

# Setelah domain aktif, aktifkan HTTPS gratis dengan Certbot:
#   sudo certbot --nginx -d data.namadomainanda.go.id
